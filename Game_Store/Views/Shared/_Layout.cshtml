<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Oyun Mağazası</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body { background-color: #1b2838; color: white; }
        .card { background-color: #171a21; color: white; border: 1px solid #2a475e; }
        .btn-outline-info.active { background-color: #66c0f4; color: #171a21; border-color: #66c0f4; }
        .btn-outline-info { color: #66c0f4; border-color: #2a475e; font-size: 0.85rem; padding: 5px 10px; }
        .btn-outline-info:hover { background-color: #2a475e; color: white; border-color: #66c0f4; }
        .sepet-kutusu { background-color: #171a21; border: 1px solid #2a475e; border-radius: 8px; padding: 15px; }

        .platform-price-btn { 
            font-size: 0.8rem; 
            padding: 4px 8px; 
            border-radius: 4px; 
            cursor: pointer;
            transition: all 0.2s;
        }
        .bg-pc { background-color: #2a475e; color: white; }
        .bg-ps { background-color: #003791; color: white; }
        .bg-xbox { background-color: #107c10; color: white; }
        .platform-price-btn:hover { opacity: 0.8; transform: scale(1.05); }

      
        .puan-yeşil { background-color: #107c10; color: white; padding: 2px 6px; border-radius: 4px; font-weight: bold; }
        .puan-sarı { background-color: #c1a100; color: black; padding: 2px 6px; border-radius: 4px; font-weight: bold; }

       
        #authEkrani {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-color: #1b2838; z-index: 9999; display: flex;
            justify-content: center; align-items: center;
        }
    </style>
</head>
<body>

    @RenderBody() 

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>